{
  "buildCommand": "pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "env": {
    "PYTHONUNBUFFERED": "1",
 "DJANGO_SETTINGS_MODULE": "nayiraah_project.settings",
    "DJANGO_DEBUG": "false"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
