# Copy this file to .env (or export these as real environment variables) and
# fill in real values before deploying. Never commit your actual .env file.

# ============================================================================
# REQUIRED FOR ALL ENVIRONMENTS (Local, Railway, Vercel, etc.)
# ============================================================================

# A long, random, unique string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key

# ============================================================================
# ENVIRONMENT-SPECIFIC SETTINGS
# ============================================================================

# LOCAL DEVELOPMENT: Set DJANGO_DEBUG=true
# VERCEL/PRODUCTION: Set DJANGO_DEBUG=false (required for security)
DJANGO_DEBUG=true

# Production domain (update based on your deployment)
# - Local dev: localhost or 127.0.0.1
# - Vercel: your-project.vercel.app or your-custom-domain.com
# - Railway: your-app.railway.app
DJANGO_SITE_DOMAIN=nayiraah.org

# Comma-separated list of all hostnames this site can be accessed from
# This prevents HTTP 400 "Bad Request" errors on the wrong domain
# VERCEL DEPLOYMENT: Add your Vercel domain and custom domain here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nayiraah.org,www.nayiraah.org,*.vercel.app

# CSRF protection: comma-separated list of origins allowed to POST to your site
# This prevents HTTP 400 "Bad Request" errors on form submissions
# VERCEL DEPLOYMENT: Must include your actual Vercel domain with https://
DJANGO_CSRF_TRUSTED_ORIGINS=https://nayiraah.org,https://www.nayiraah.org

# ============================================================================
# PRODUCTION-ONLY SETTINGS (leave commented for local development)
# ============================================================================

# Only relevant in production (DJANGO_DEBUG=false)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SESSION_COOKIE_SECURE=true

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Leave DJANGO_EMAIL_BACKEND unset to use the console backend in debug mode.
# In production, configure SMTP settings:

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=no-reply@nayiraah.org
DJANGO_EMAIL_HOST_PASSWORD=change-me
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=no-reply@nayiraah.org

# Comma-separated "Name:email" pairs who receive contact-form notifications
DJANGO_ADMINS=Niyati:you@example.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Local development uses SQLite (no configuration needed)
# Production on Vercel/Railway: Set DATABASE_URL to your PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ============================================================================
# VERCEL-SPECIFIC SETUP INSTRUCTIONS
# ============================================================================
# 1. Set DJANGO_DEBUG=false in Vercel Environment Variables
# 2. Set DJANGO_SECRET_KEY to a secure random string
# 3. Update DJANGO_SITE_DOMAIN to your actual domain
# 4. Update DJANGO_ALLOWED_HOSTS to include your Vercel domain
# 5. Update DJANGO_CSRF_TRUSTED_ORIGINS to include your Vercel domain
# 6. If using custom domain, update all domain references above
# 7. Configure DATABASE_URL if using PostgreSQL
# 8. Configure EMAIL settings if you want to send emails
